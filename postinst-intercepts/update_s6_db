#!/bin/sh

set -e

# Build the s6-rc repository and the boot database for the image.
#
# The tools are the native builds, which are configured with the target's
# paths for the two things s6-rc-compile embeds in what it generates (the
# execline shebang and the libexec prefix), so a database compiled here is
# byte for byte the one the target would have compiled for itself. Nothing
# needs to run under emulation.
#
# The repository is built the way the target would build it, rather than the
# boot database being assembled by hand, so that what boots is exactly what
# s6-rc-set-commit produces and the first repo operation on the target does
# not silently change the boot set.

repo=$D${localstatedir}/lib/s6-rc/repository

# Both stores are recorded even when the local one is empty, so that the
# repository's store list matches the one s6-frontend is built with and an
# administrator can drop definitions into /etc/s6/sources without having to
# update the stores first.
install -d "$D${sysconfdir}/s6/sources"
stores="$D${datadir}/s6/sources $D${sysconfdir}/s6/sources"

# s6-rc-repo-init does not create the parent of the repository
install -d "${repo%/*}"

if [ -d "$repo" ]; then
	s6-rc-repo-sync -r "$repo"
else
	s6-rc-repo-init -r "$repo" $stores
	s6-rc-set-new -r "$repo" current
fi

s6-rc-set-fix -u -r "$repo" current
s6-rc-set-commit -r "$repo" current

# Install the committed set as the boot database. s6-rc-set-install cannot be
# used here: it updates the live database, which does not exist yet.
rm -rf $D${sysconfdir}/s6-rc/compiled/initial
install -d $D${sysconfdir}/s6-rc/compiled
cp -a "$repo"/compiled/current/. $D${sysconfdir}/s6-rc/compiled/initial
chown -R root:root $D${sysconfdir}/s6-rc/compiled/initial
ln -sf initial $D${sysconfdir}/s6-rc/compiled/current

# The repository records the stores by the path it was given, so the store
# links are the one thing in it that points into the build tree; everything
# else is relative to the repository itself.
for link in "$repo"/.stores:*/*; do
	[ -L "$link" ] || continue
	target=$(readlink "$link")
	case "$target" in
	"$D"/*)
		ln -sfn "${target#$D}" "$link"
		;;
	esac
done
chown -R root:root "$repo"
