#!/bin/sh -e

### Initialize the service manager and start the services enabled at
### boot. s6 system boot performs both phases, reading its paths from
### /etc/s6.conf, and upstream is explicit that no other command needs
### to appear in this script.
###
### Runlevels are a sysvinit notion: under s6-rc the set of services to
### start is a property of the committed set, changed with s6 set, not
### of the kernel command line.

exec s6 system boot
